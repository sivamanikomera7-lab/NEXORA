# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Session & Download Token Security (generate strong random 64-char hex strings in production)
SESSION_SECRET="replace-with-secure-64-char-random-secret"
DOWNLOAD_TOKEN_SECRET="replace-with-secure-64-char-download-secret"

# Razorpay Payment Gateway (Server-side secret must NEVER have VITE_ prefix)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# SMTP Email Configuration (for automated order confirmation & download receipts)
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASS="re_xxxxxxxxxxxxxx"
SMTP_FROM="NEXORA <orders@nexora.digital>"

# Optional Supabase / PostgreSQL (used in standalone Next.js / Cloudflare production guide)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
